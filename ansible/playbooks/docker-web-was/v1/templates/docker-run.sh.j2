#!/usr/bin/env bash
set -euo pipefail

docker rm -f "{{ docker_container_name }}" >/dev/null 2>&1 || true

docker run -d \
  --name "{{ docker_container_name }}" \
  --restart "{{ docker_restart_policy }}" \
{% for port in docker_ports | default([]) %}
  -p "{{ port }}" \
{% endfor %}
{% for volume in docker_volumes | default([]) %}
  -v "{{ volume }}" \
{% endfor %}
  "{{ docker_image }}"
