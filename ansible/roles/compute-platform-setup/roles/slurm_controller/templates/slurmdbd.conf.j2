# Ansible managed - slurm_controller
AuthType=auth/munge
DbdHost={{ ansible_hostname }}
DbdPort={{ slurm_accounting_port }}
SlurmUser=slurm
DebugLevel=info
LogFile={{ slurmdbd_log_path }}
PidFile=/run/slurmdbd.pid
StorageType=accounting_storage/mysql
StorageHost=localhost
StoragePort=3306
StorageUser={{ slurm_accounting_db_user }}
StorageLoc={{ slurm_accounting_db_name }}
